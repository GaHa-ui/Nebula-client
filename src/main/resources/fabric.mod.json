{
  "schemaVersion": 1,
  "id": "nebula",
  "version": "${version}",
  "name": "Nebula Client",
  "description": "Modern Fabric PvP client for Minecraft 1.21.11 with modular HUD, cosmetics-ready UI, and waypoints.",
  "authors": ["Nebula Team"],
  "contact": {
    "homepage": "https://nebula-client.example.com",
    "sources": "https://github.com/NebulaClient/Nebula-client",
    "issues": "https://github.com/NebulaClient/Nebula-client/issues"
  },
  "license": "MIT",
  "icon": "assets/nebula/textures/gui/logo_placeholder.png",
  "environment": "client",
  "entrypoints": {
    "main": ["dev.nebula.client.NebulaClient"],
    "client": ["dev.nebula.client.NebulaClient"]
  },
  "mixins": ["nebula.mixins.json"],
  "depends": {
    "fabricloader": ">=0.17.3",
    "minecraft": "1.21.11",
    "java": ">=21",
    "fabric-api": ">=0.141.3+1.21.11"
  },
  "suggests": {
    "sodium": "*",
    "lithium": "*",
    "iris": "*",
    "krypton": "*",
    "modmenu": "*"
  }
}
